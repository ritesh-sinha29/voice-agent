# ==============================================================================
# Rumik ₹1 AI Voice Agent Stack - Environment Configuration
# ==============================================================================

# Deployment Mode (AUTO | LOCAL | CLOUD)
DEPLOY_MODE=LOCAL

# Cloud Deployment (Required only if DEPLOY_MODE=CLOUD)
VPS_IP=
SSH_KEY=

# Dograh Orchestrator Credentials
DOGRAH_EMAIL=admin@example.com
DOGRAH_PASSWORD=ChangeThisStrongPass123!
DOGRAH_URL=http://localhost:3000
DOGRAH_PUBLIC_URL=

# VoBiz Primary Carrier (India)
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_NUMBER=+91XXXXXXXXXX

# VoiceLink Secondary Carrier (Optional)
VOICELINK_RESELLER_USER=
VOICELINK_RESELLER_PASS=
VOICELINK_DID=

# AI Pipeline Providers (Target ~ ₹1/min AI runtime)
DEEPGRAM_API_KEY=
GROQ_API_KEY=
RUMIK_API_KEY=

# LLM Selection (groq | gemini)
LLM_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Voice Studio App Configuration
PORT=8787
# SECURITY: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=CHANGE_ME_GENERATE_WITH_secrets_token_hex_32
ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_secrets_token_hex_16
# API key for securing dashboard-to-agent and inter-service calls
DASHBOARD_API_KEY=CHANGE_ME_GENERATE_WITH_secrets_token_hex_24

# Explicitly Confirmed Outbound Test Number (E.164)
TEST_NUMBER=
